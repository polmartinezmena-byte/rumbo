{
  "name": "rumbo",
  "version": "0.2.0",
  "private": true,
  "description": "Navegador GPS que funciona sin conexión: rutas, búsqueda, ruta segura ante inundaciones y SOS.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node dev-server.mjs",
    "build:region": "node --max-old-space-size=12000 tools/build-region.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node tools/build-web.mjs",
    "android:sync": "node tools/build-web.mjs && npx cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0"
  }
}
